# Copy to adam-gcp.env (gitignored) for deploy scripts. Never commit values.
export GCP_PROJECT_ID=creative-ai-491118
export GCP_REGION=us-east4
export ADAM_CLOUD_RUN_SERVICE=dear-creative-adam
export ADAM_RUNTIME_SA=dear-creative-adam-run

# Optional: dedicated Cloud Build service account for `gcloud run deploy --source`.
# export ADAM_CLOUD_BUILD_SA=dear-creative-adam-cloudbuild

# Secret resource names (Secret Manager). Add versions manually; scripts never print values.
export ADAM_SECRET_DEAR_APP_API_TOKEN=dear-creative-adam-dear-app-api-token
export ADAM_SECRET_DEAR_APP_BASE_URL=dear-creative-adam-dear-app-base-url
