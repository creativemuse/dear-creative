# Turso (libSQL) — use file: URL locally; hosted URL + token in production only
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_FROM=
# Set to exactly "true" to call Resend send APIs; otherwise newsletter delivery logs only.
RESEND_LIVE=false
RESEND_WEBHOOK_SECRET=

# Subscriber double opt-in / unsubscribe tokens (local secret; generate in dev)
SUBSCRIBER_TOKEN_SECRET=

# Public site origin for email links (local dev)
NEXT_PUBLIC_SITE_URL=

# X (OAuth 2.0 user context)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=

# Payments (default off — human CRTVAI / Unlock checkout deferred until G2 pricing)
PAYMENTS_ENABLED=false
# Unlock pass entitlements on Base (default off — no pass-based access when false)
DEAR_PASS_ENTITLEMENT_ENABLED=false
# Comma-separated PublicLock addresses; defaults to Creator / Brand / Professional locks
# DEAR_QUALIFYING_LOCKS=0xf7c4cd399395d80f9d61fde833849106775269c6,0x9c3744c96200a52d05a630d4aec0db707d7509be,0x13b818daf7016b302383737ba60c3a39fef231cf
# Coinbase CDP / x402 (Base Sepolia agent paywall; set when PAYMENTS_ENABLED=true)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
X402_PAY_TO_ADDRESS=
X402_MAX_AMOUNT_REQUIRED=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_ADMIN_USER_IDS=

# Adam (Cloud Run) → web app API (Bearer token for /api/adam/*)
ADAM_API_TOKEN=
# Base URL of the deployed Dear Creative app (Cloud Run Adam service uses Secret Manager)
# DEAR_CREATIVE_API_BASE_URL=

# Local dev default (file-backed libSQL). Override only for local/dev imports.
LOCAL_DATABASE_URL=file:./data/dear-creative.db
