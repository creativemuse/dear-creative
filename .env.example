# Turso (libSQL) — use file: URL locally; hosted URL + token in production only
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# X (OAuth 2.0 user context)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=

# Coinbase CDP / x402
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
X402_PAY_TO_ADDRESS=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Adam (Cloud Run) → web app API
ADAM_API_TOKEN=

# Local dev default (file-backed libSQL). Override only for local/dev imports.
LOCAL_DATABASE_URL=file:./data/dear-creative.db
