{
  "name": "dear-creative-adam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "build:agent": "tsc --noEmit -p tsconfig.agent.json",
    "build:prod": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "start": "npx @google/adk-devtools api_server . --port ${PORT:-8080} --host 0.0.0.0",
    "smoke:draft": "npm run build:prod && node dist/src/smoke-draft.js"
  },
  "dependencies": {
    "@google/adk": "^2.3.0",
    "@google/adk-devtools": "^2.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
